{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KYC Lifecycle Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "tenant_id", "customer_id", "occurred_at", "produced_at", "payload", "metadata"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "enum": ["CUSTOMER_ONBOARDED", "DOCUMENT_UPLOADED", "DOCUMENT_CONTROL_COMPLETED", "IDENTITY_VERIFICATION_COMPLETED", "WATCHLIST_SCREENING_COMPLETED", "RISK_SCORE_UPDATED", "CASE_DECISIONED"] },
    "event_version": { "type": "integer", "minimum": 1 },
    "tenant_id": { "type": "string", "minLength": 2 },
    "customer_id": { "type": "string", "minLength": 8 },
    "correlation_id": { "type": ["string", "null"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "produced_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "metadata": { "type": "object" }
  }
}
